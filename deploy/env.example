# Настройки развёртывания. Скопируйте в .env рядом с docker-compose.yml.
#
#   cp deploy/env.example .env
#
# Файл .env содержит пароли и в репозиторий не попадает.

# Домен, по которому открывается кассовый экран. Caddy сам получит на него
# сертификат, поэтому домен должен уже указывать A-записью на эту машину.
# Для проверки на своей машине: CYBERFOX_DOMAIN=:80 — но так HTTPS не будет,
# и в зал в таком виде ставить нельзя.
CYBERFOX_DOMAIN=club.example.kz

# Откуда браузеру разрешено обращаться к API. В обычной установке это тот же
# домен. Пусто — разрешены любые источники, годится только для разработки.
ALLOWED_ORIGINS=https://club.example.kz

# База. Пароль придумайте длинный: наружу порт не открыт, но общий пароль
# на все клубы — это одна утечка на всех.
POSTGRES_USER=cyberfox
POSTGRES_PASSWORD=
POSTGRES_DB=cyberfox

# Подпись токенов сотрудников. Смена значения разлогинивает всех.
#   openssl rand -hex 32
JWT_SECRET=

# Приём платежей. manual — онлайн-оплаты нет, кассир отмечает переводы руками.
# Для боевого провайдера укажите адрес страницы оплаты и секрет подписи
# вебхука: по нему проверяется, что подтверждение пришло действительно от него.
PAYMENT_PROVIDER=manual
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Часовой пояс клуба: по нему считаются смены, ночные тарифы и отчёты.
TZ=Asia/Almaty
