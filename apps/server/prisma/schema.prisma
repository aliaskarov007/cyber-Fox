// Схема Cyber-Fox. Модель соответствует docs/billing.md и docs/guest-access.md.
//
// Два сквозных правила:
//   1. Всё принадлежит сети (Tenant) и почти всё — конкретному клубу (clubId).
//      Разделение по клубам — то, что позже пустит в систему чужих владельцев.
//   2. Деньги хранятся целыми числами в тиын (1/100 ₸). Поминутная цена часто
//      получается делением часовой, и дробные значения за смену расходятся с кассой.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Тот, кто продаёт систему клубам, а не работает в зале.
 *
 * Отдельно от сотрудников намеренно. Учётная запись платформы видит все сети
 * сразу, и жить рядом с кассовыми входами она не должна: утёкший пароль
 * администратора зала не открывает чужие клубы, а платформенный вход не
 * появляется в списке сотрудников ни одного клуба.
 */
model PlatformAdmin {
  id           String  @id @default(uuid())
  email        String  @unique
  fullName     String
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Сеть клубов одного владельца. Единица подписки на платформу.
model Tenant {
  id   String @id @default(uuid())
  name String

  /// true — один кошелёк гостя на всю сеть; false — свой кошелёк в каждом клубе.
  /// Аккаунт и история визитов общие в обоих случаях.
  sharedBalance Boolean @default(false)

  clubs        Club[]
  guests       Guest[]
  staff        Staff[]
  subscription Subscription?
  invoices     Invoice[]
  paymentIntents PaymentIntent[]
  whatsapp     WhatsAppChannel?
  events       Event[]
  guestSignups GuestSignup[]
  promoCodes   PromoCode[]
  promoRedemptions PromoRedemption[]
  barOrders    BarOrder[]
  winbackCampaigns WinbackCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionPlan {
  /// Бесплатный пробный период после самостоятельной регистрации.
  TRIAL
  /// Один зал.
  BASIC
  /// Сеть залов и сводные отчёты.
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  /// Срок оплаты прошёл, но зал ещё работает: льготный период.
  PAST_DUE
  /// Льготный период кончился — новые сессии не запускаются.
  SUSPENDED
  CANCELED
}

/**
 * Подписка сети на платформу. Единица продажи — сеть, а не зал:
 * владелец платит один раз за все свои клубы.
 */
model Subscription {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(TRIAL)
  status SubscriptionStatus @default(TRIALING)

  /// Сколько машин разрешено подключить. Превышение блокирует заведение новых.
  maxComputers Int @default(10)
  /// Цена за машину в месяц, в тиын.
  pricePerComputer Int @default(0)

  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  /// До какого момента зал работает после просрочки.
  graceEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Зачем создан платёж: пополнение счёта гостя или оплата нашего счёта клубом.
enum PaymentPurpose {
  GUEST_TOPUP
  SUBSCRIPTION_INVOICE
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
}

/**
 * Намерение оплаты — то, что мы показали плательщику, и то, чего ждём от
 * провайдера. Отдельная сущность нужна ровно потому, что подтверждение придёт
 * позже, отдельным запросом, и может прийти несколько раз.
 */
model PaymentIntent {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Клуб, чья касса принимает деньги. Пусто для оплаты подписки.
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  purpose PaymentPurpose
  status  PaymentIntentStatus @default(PENDING)

  /// Сумма в тиын. Сверяется с суммой из подтверждения провайдера.
  amount Int

  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  /// Имя провайдера: kaspi, cloudpayments, manual.
  provider String
  /// Идентификатор платежа на стороне провайдера; по нему приходит подтверждение.
  providerRef String? @unique
  /// Ссылка на страницу оплаты. Хранится, чтобы повторный показ платежа
  /// возвращал тот же QR, а не пустоту.
  checkoutUrl String?
  /// Игровой ПК, на экране которого показан QR: туда уходит весть об оплате.
  computerId String?

  /// Ключ идемпотентности запроса на создание: повторный клик по кнопке
  /// не должен плодить платежи.
  idempotencyKey String @unique

  paidAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, expiresAt])
}

enum InvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  VOID
}

/// Счёт сети за пользование платформой.
model Invoice {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  /// Машин на момент выставления — по ним считается сумма.
  computers Int
  /// Сумма в тиын.
  amount Int
  status InvoiceStatus @default(ISSUED)

  issuedAt DateTime  @default(now())
  dueAt    DateTime
  paidAt   DateTime?

  paymentIntents PaymentIntent[]

  createdAt DateTime @default(now())

  @@index([tenantId, issuedAt])
}

model Club {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  city     String?
  timezone String @default("Asia/Almaty")

  /// Лимит игры в долг, в тиын. Действует одинаково онлайн и офлайн.
  creditLimit Int @default(10000)
  /// Срок жизни пакета по умолчанию; задаёт владелец клуба.
  packageValidityDays Int @default(30)
  /// За сколько минут до конца пакета предупреждать гостя.
  lowBalanceWarnMinutes Int @default(10)
  /// Сколько процентов от потраченного возвращается бонусами. 0 — программа выключена.
  bonusPercent Int @default(0)
  /// Гость может заказать из бара прямо с игрового ПК и оплатить с баланса.
  /// Выключено по умолчанию: включает владелец, когда готов носить заказы к местам.
  barOrdersFromPc Boolean @default(false)
  /// Картинка статического QR клуба из банковского приложения (единый QR).
  /// Показывается на игровом ПК, пока банк не подключён напрямую: гость платит
  /// по нему, администратор подтверждает поступление.
  paymentQrImageUrl String?

  /// Ключ клуба для бездисковых залов. Один на весь клуб, кладётся в общий
  /// образ рядом с агентом: машины называют себя MAC-адресом, а этот ключ
  /// говорит серверу, к какому клубу они относятся.
  /// Значение ставит сама база, а не Prisma: миграция бездисковых залов раздала
  /// ключи существующим клубам и оставила такой же умолчанием, чтобы клуб,
  /// заведённый в обход приложения, не остался без ключа. Схема это объявляет —
  /// иначе она молча расходится с базой.
  enrollmentKey String @unique @default(dbgenerated("(gen_random_uuid())::text"))

  zones     Zone[]
  computers Computer[]
  tariffs   Tariff[]
  wallets   GuestWallet[]
  packages  GuestPackage[]
  sessions  Session[]
  payments  Payment[]
  shifts    Shift[]
  staff     Staff[]
  products  Product[]
  sales     ProductSale[]
  paymentIntents PaymentIntent[]
  apps      ClubApp[]
  appSuggestions AppSuggestion[]
  events    Event[]
  promoCodes PromoCode[]
  barOrders BarOrder[]
  winbackCampaigns WinbackCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Зона зала: VIP, Стандарт, PS5. Тарифы принадлежат зоне.
model Zone {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  /// Тариф, подхватываемый когда минуты пакета кончились.
  /// Ссылка необязательная: зону заводят раньше, чем её тарифы.
  defaultPerMinuteTariffId String? @unique
  defaultPerMinuteTariff   Tariff? @relation("ZoneDefaultTariff", fields: [defaultPerMinuteTariffId], references: [id])

  computers Computer[]
  tariffs   Tariff[]   @relation("ZoneTariffs")
  packages  GuestPackage[]
  sessions  Session[]
  apps      ClubApp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, name])
  @@index([clubId])
}

/// Чем запускается игра: программой на диске машины или ссылкой вида
/// steam://rungameid/730, которую откроет уже установленный клиент.
enum AppLaunchKind {
  EXECUTABLE
  URI
}

/// Игра или программа. Гость ищет их по-разному: за игрой приходят, браузер
/// открывают между делом, — поэтому в оболочке это разные вкладки.
enum AppSection {
  GAME
  APP
}

/// Игра или программа на полке оболочки.
///
/// Каталог принадлежит клубу, а не машине: в бездисковом зале образ у всех
/// общий, и путь до игры на всех машинах одинаковый. Добавленная в кассе игра
/// появляется у всего зала сразу, без правки образа.
model ClubApp {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Зона, если игра только для неё: на VIP-машинах бывает свой набор.
  /// Пусто — во всех зонах клуба.
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  name     String
  /// Жанр: «Шутеры», «Гонки». В оболочке по нему фильтруют кнопками.
  category String?
  /// Вкладка оболочки, в которой запись показывается.
  section  AppSection @default(GAME)

  kind AppLaunchKind @default(EXECUTABLE)
  /// Путь к программе на машине зала либо ссылка запуска.
  target String
  /// Аргументы командной строки, если игра их требует.
  args String[] @default([])

  /// Обложка. Хранится ссылкой, а не файлом: у Steam-игр она берётся с их же
  /// раздачи, и складывать гигабайты картинок в базу клуба незачем.
  coverUrl String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  favourites GuestFavourite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, name])
  @@index([clubId])
  @@index([zoneId])
}

/**
 * Игра, найденная агентом на машине зала, но ещё не поставленная на полку.
 *
 * Отдельно от каталога намеренно: на машинах стоит и то, что гостю показывать
 * незачем — служебные программы, чужие лаунчеры, старьё. Владелец смотрит
 * список и берёт нужное, а не разгребает полки после первой же загрузки.
 */
/// Игра, отмеченная гостем как своя.
///
/// Гость возвращается к двум-трём играм из сорока, и каждый раз искать их среди
/// остальных — лишняя работа. Отмеченные встают первыми.
model GuestFavourite {
  guestId String
  guest   Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  appId   String
  app     ClubApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([guestId, appId])
  @@index([guestId])
}

model AppSuggestion {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name   String
  kind   AppLaunchKind @default(URI)
  /// Ссылка запуска или путь к программе — он же признак повтора.
  target String
  coverUrl String?

  /// Где нашли. В бездисковом зале образ общий, поэтому достаточно одной
  /// машины, но знать, кто сообщил, полезно при разборе.
  computerId String?
  seenAt     DateTime @default(now())

  @@unique([clubId, target])
  @@index([clubId])
}

enum ComputerStatus {
  OFFLINE
  IDLE
  IN_USE
  RESERVED
  MAINTENANCE
}

model Computer {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  name   String
  status ComputerStatus @default(OFFLINE)

  /// Код привязки: агент предъявляет его при первом подключении.
  pairingToken String?   @unique
  hostname     String?
  /// MAC сетевой карты. На бездисковых машинах это единственный устойчивый
  /// признак: образ у всех общий, а настройки в профиле стираются при
  /// перезагрузке. Сама загрузка по сети без уникального MAC невозможна.
  macAddress String?
  lastSeenAt DateTime?

  /// Место машины на плане зала: столбец и ряд, как она стоит в помещении.
  /// Пусто у тех, кого ещё не расставили — такие показываются общим списком
  /// под планом, а не сваливаются в угол поверх друг друга.
  posX Int?
  posY Int?

  sessions          Session[]
  offlineOperations OfflineOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, name])
  @@unique([clubId, macAddress])
  @@index([clubId])
  @@index([zoneId])
}

enum TariffKind {
  PACKAGE
  PER_MINUTE
}

model Tariff {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  zoneId String
  zone   Zone   @relation("ZoneTariffs", fields: [zoneId], references: [id])

  name String
  kind TariffKind

  /// Для PER_MINUTE: цена минуты в тиын.
  pricePerMinute Int?
  /// Для PACKAGE: сколько минут и за сколько.
  packageMinutes Int?
  packagePrice   Int?
  /// Срок жизни пакета; пусто — берём packageValidityDays клуба.
  validityDays   Int?

  /// Для PACKAGE: чем продолжать после исчерпания.
  /// Пусто — берём defaultPerMinuteTariffId зоны.
  fallbackTariffId String?
  fallbackTariff   Tariff?  @relation("TariffFallback", fields: [fallbackTariffId], references: [id])
  fallbackFor      Tariff[] @relation("TariffFallback")

  /// Окно действия по времени суток, минуты от полуночи. Пусто — круглосуточно.
  activeFromMinute Int?
  activeToMinute   Int?
  /// Дни недели, 1 = понедельник. Пусто — все дни.
  daysOfWeek Int[]

  isActive Boolean @default(true)

  defaultForZone Zone?          @relation("ZoneDefaultTariff")
  packages       GuestPackage[]
  segments       SessionSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Два одинаковых названия в одной зоне админ на стойке не различит.
  @@unique([clubId, zoneId, name])
  @@index([clubId])
  @@index([zoneId])
}

/// Аккаунт гостя. Принадлежит сети, а не залу: гость узнан в любом клубе владельца.
model Guest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName String
  /// Уникален в пределах сети.
  phone    String

  /// PIN для самостоятельного входа за игровым ПК. Хранится хешем.
  pinHash String?
  /// Счётчик неверных попыток и блокировка ввода; см. docs/guest-access.md.
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  bonusPoints Int @default(0)

  /// Когда гость подтвердил номер кодом из WhatsApp. Пусто — номер не проверен,
  /// и приглашений на ивенты такой гость не получает: писать на чужой или
  /// опечатанный номер — прямой путь к блокировке номера клуба.
  phoneVerifiedAt DateTime?
  /// Гость ответил «СТОП» на рассылку. Приглашения ему больше не уходят,
  /// пока он сам не напишет «СТАРТ».
  invitesOptOutAt DateTime?

  wallets  GuestWallet[]
  packages GuestPackage[]
  sessions Session[]
  favourites GuestFavourite[]
  payments Payment[]
  sales    ProductSale[]
  paymentIntents PaymentIntent[]
  phoneCodes PhoneVerification[]
  invites    EventInvite[]
  promoRedemptions PromoRedemption[]
  barOrders  BarOrder[]
  personalPromos PromoCode[] @relation("PersonalPromo")
  winbackMessages WinbackMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
}

/// Кошелёк гостя. clubId пуст — кошелёк общий на всю сеть (Tenant.sharedBalance).
model GuestWallet {
  id      String @id @default(uuid())
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// В тиын. Может быть отрицательным — гость доигрывал в долг.
  balance Int @default(0)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один кошелёк на пару (гость, клуб); общий кошелёк — единственный с clubId = null.
  @@unique([guestId, clubId])
  @@index([guestId])
}

enum GuestPackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REFUNDED
}

/// Купленные минуты на аккаунте гостя. По сети не ходят: привязаны к клубу и зоне.
model GuestPackage {
  id      String @id @default(uuid())
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  zoneId  String
  zone    Zone   @relation(fields: [zoneId], references: [id])

  sourceTariffId String
  sourceTariff   Tariff @relation(fields: [sourceTariffId], references: [id])

  minutesTotal     Int
  minutesRemaining Int
  pricePaid        Int

  purchasedAt DateTime           @default(now())
  expiresAt   DateTime
  status      GuestPackageStatus @default(ACTIVE)

  segments SessionSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Подбор пакета при старте сессии: своя зона, активные, ближайший к сгоранию первым.
  @@index([guestId, zoneId, status, expiresAt])
  @@index([clubId])
}

enum SessionStatus {
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

enum SessionStartedBy {
  GUEST
  STAFF
}

model Session {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  computerId String
  computer   Computer @relation(fields: [computerId], references: [id])
  zoneId     String
  zone       Zone     @relation(fields: [zoneId], references: [id])

  /// Пусто — анонимная посадка: без аккаунта, строго по предоплате.
  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id])

  status    SessionStatus    @default(ACTIVE)
  startedBy SessionStartedBy
  /// Начата в аварийном режиме без связи с облаком.
  startedOffline Boolean @default(false)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Когда списывать следующую минуту. Индексируется: рабочий выбирает
  /// просроченные сессии пачками, таймера на сессию нет. См. docs/billing.md, раздел 8.
  nextChargeAt DateTime?

  /// Сумма по всем отрезкам, в тиын.
  totalCharged Int @default(0)

  /// Остаток предоплаты для анонимной посадки, в тиын.
  /// У гостя с аккаунтом деньги живут в кошельке, здесь пусто.
  prepaidRemaining Int?


  segments     SessionSegment[]
  payments     Payment[]
  transactions Transaction[]
  sales        ProductSale[]
  offlineOps   OfflineOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Рабочий списания: выбрать активные сессии, у которых подошёл срок.
  @@index([status, nextChargeAt])
  @@index([clubId, startedAt])
  @@index([computerId])
  @@index([guestId])
}

enum SegmentEndReason {
  PACKAGE_EXHAUSTED
  CREDIT_LIMIT
  /// Закончилась предоплата анонимной посадки. Отдельно от CREDIT_LIMIT:
  /// кредита у гостя без аккаунта нет, и в отчёте это разные события.
  PREPAID_EXHAUSTED
  ZONE_CHANGE
  TARIFF_SCHEDULE
  STOPPED_BY_STAFF
  STOPPED_BY_GUEST
  /// Агент машины давно не выходил на связь: сессия закрыта, чтобы зал
  /// не показывал занятым место, за которым никто не играет.
  AGENT_LOST
  PAUSED
}

/// Отрезок сессии с одним тарифом. Сессия — цепочка таких отрезков.
/// После закрытия неизменяем: на этом стоит безопасность агрегатов в отчётах.
model SessionSegment {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  tariffId String
  tariff   Tariff     @relation(fields: [tariffId], references: [id])
  kind     TariffKind

  /// Для PACKAGE: из какого пакета аккаунта тратились минуты.
  guestPackageId String?
  guestPackage   GuestPackage? @relation(fields: [guestPackageId], references: [id])

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  minutesUsed Int @default(0)
  /// Сколько минут уже оплачено; ключ идемпотентности списания.
  /// Сдвигается в той же транзакции, что и баланс.
  chargedThroughMinute Int @default(0)
  charged              Int @default(0)

  endReason SegmentEndReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, startedAt])
}

/// Товар бара: снеки, напитки. Продаётся с того же экрана, что и время.
model Product {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name     String
  category String?
  /// Цена продажи и себестоимость, в тиын. Себестоимость нужна для маржи в отчёте.
  price Int
  cost  Int    @default(0)

  /// Остаток на складе. Пусто — товар без учёта остатков (например, кофе из зерна).
  stock Int?

  isActive Boolean @default(true)

  sales ProductSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, name])
  @@index([clubId])
}

/// Проданная позиция. Цена и себестоимость копируются в момент продажи:
/// изменение прайса завтра не должно переписывать вчерашнюю выручку.
model ProductSale {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  quantity      Int
  priceAtSale   Int
  costAtSale    Int
  total         Int
  method        PaymentMethod

  /// Заказ с игрового ПК, к которому относится позиция.
  orderId String?
  order   BarOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([shiftId])
  @@index([guestId])
  @@index([orderId])
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  BALANCE
  BONUS
}

/// Приём денег на стойке. Записывается в клуб, где физически принят платёж.
model Payment {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  guestId String?
  guest   Guest?  @relation(fields: [guestId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  /// В тиын.
  amount Int
  method PaymentMethod

  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([shiftId])
}

enum TransactionType {
  TOPUP
  SESSION_CHARGE
  PACKAGE_PURCHASE
  PRODUCT_SALE
  REFUND
  ADJUSTMENT
  DEBT_WRITE_OFF
  BONUS_ACCRUAL
  BONUS_SPEND
  /// Деньги по промокоду. Это не платёж: в кассу смены не попадает.
  PROMO
}

/// Движение по кошельку гостя. Расход записывается в клуб, где шла сессия,
/// пополнение — в клуб, где принят платёж. Разница между ними и есть
/// межклубный взаимозачёт при общем кошельке (docs/billing.md, раздел 9.3).
model Transaction {
  id       String      @id @default(uuid())
  walletId String
  wallet   GuestWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// Клуб, которому принадлежит событие: касса при пополнении, зал при расходе.
  clubId String

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  type TransactionType
  /// В тиын: положительная — приход, отрицательная — расход.
  amount Int
  /// Баланс кошелька после операции; нужен для разбора спорных смен.
  balanceAfter Int

  comment String?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([clubId, createdAt])
  @@index([sessionId])
}

/**
 * Операция, выполненная без связи с облаком, и досланная после восстановления.
 *
 * UUID генерируется на устройстве и служит ключом идемпотентности: повторная
 * доставка той же пачки ничего не меняет (docs/offline.md, раздел 5).
 */
model OfflineOperation {
  uuid String @id

  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  /// Монотонный номер устройства — для восстановления порядка внутри пачки.
  sequence Int
  kind     String

  /// Минуты, отыгранные локально и подлежащие списанию на сервере.
  minutes Int @default(0)

  /// Часы устройства и последнее известное время сервера: сверка подкрутки часов.
  deviceTime          DateTime
  lastKnownServerTime DateTime?

  /// Когда сервер применил операцию. Пусто — принята, но не применена.
  appliedAt DateTime?
  /// Заполняется, если применить не удалось: расхождение попадает в отчёт.
  rejectedReason String?

  createdAt DateTime @default(now())

  @@index([computerId, sequence])
  @@index([sessionId])
}

enum StaffRole {
  OWNER
  ADMIN
  STAFF
}

model Staff {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Клуб сотрудника; пусто у владельца сети — он видит все залы.
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  email        String
  fullName     String
  passwordHash String
  /// PIN для входа в кассовый экран в аварийном режиме.
  pinHash  String?
  role     StaffRole
  isActive Boolean   @default(true)

  /// Версия выданных токенов. Увольнение, смена пароля и смена роли поднимают
  /// её, и прежние токены перестают действовать: до этого уволенному хватало
  /// не закрывать вкладку, а срок жизни токена — двенадцать часов.
  tokenVersion Int @default(0)

  shifts   Shift[]
  payments Payment[]
  sales    ProductSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([clubId])
}

model Shift {
  id      String @id @default(uuid())
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime?

  /// Размен в кассе на начало смены, в тиын. Без него сверка не сходится.
  openingFloat Int @default(0)

  /// Сверка кассы на закрытии, в тиын. Ожидаемое считается системой,
  /// пересчитанное вводит сотрудник; разница остаётся в истории как есть.
  cashExpected Int?
  cashCounted  Int?
  note         String?

  payments Payment[]
  sales    ProductSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Открытая смена в клубе должна быть одна: две кассы одновременно не сверить.
  @@index([clubId, openedAt])
  @@index([clubId, closedAt])
}

/**
 * Подключение сети к WhatsApp через Green-API.
 *
 * Один номер на сеть: гость общий для всех залов, и писать ему должен один
 * и тот же отправитель, иначе ответ «иду» уйдёт не туда.
 * Токен инстанса наружу не отдаётся — с ним можно писать от имени клуба.
 */
model WhatsAppChannel {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Адрес API из личного кабинета Green-API (у новых инстансов он свой).
  apiUrl     String @default("https://api.green-api.com")
  instanceId String @unique
  apiToken   String
  /// Секрет входящих уведомлений: Green-API присылает его в заголовке Authorization.
  webhookToken String @unique @default(uuid())

  /// Номер, привязанный к инстансу, — на него гость пишет код регистрации.
  /// Сервер узнаёт его у Green-API сам: вводить вручную — значит ошибиться.
  phone String?

  /// Последнее известное состояние инстанса: authorized, notAuthorized и т.п.
  lastState   String?
  lastCheckAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Код подтверждения номера гостя. Хранится хешем, живёт несколько минут. */
model PhoneVerification {
  id      String @id @default(uuid())
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([guestId, createdAt])
}

enum EventAudience {
  /// Все гости сети с подтверждённым номером.
  NETWORK
  /// Только те, кто хоть раз играл в зале ивента.
  CLUB
}

/** Ивент в зале: турнир, LAN-вечер, ночь с акцией. Приглашения расходятся по сети. */
model Event {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  title       String
  description String?
  startsAt    DateTime
  audience    EventAudience @default(NETWORK)

  createdById String?
  /// Когда разослали приглашения. Пусто — черновик.
  sentAt     DateTime?
  canceledAt DateTime?

  invites EventInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startsAt])
  @@index([clubId, startsAt])
}

enum InviteStatus {
  /// В очереди на отправку.
  PENDING
  SENT
  FAILED
  GOING
  DECLINED
}

model EventInvite {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId String
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status InviteStatus @default(PENDING)
  providerMessageId String?
  error       String?
  sentAt      DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один гость — одно приглашение на ивент: повторная рассылка не спамит.
  @@unique([eventId, guestId])
  @@index([status, createdAt])
  @@index([guestId, sentAt])
}

enum GuestSignupStatus {
  /// QR на экране, ждём сообщения от гостя.
  WAITING
  /// Гость прислал код со своего номера — номер его.
  CONFIRMED
  /// Аккаунт создан или PIN задан заново.
  COMPLETED
}

/**
 * Регистрация гостя за игровым ПК.
 *
 * Гость сканирует QR и сам отправляет код на номер клуба. Номер отправителя
 * WhatsApp подставляет сам — подделать его нельзя, поэтому отдельный код
 * подтверждения не нужен, а клуб не пишет первым незнакомому номеру.
 */
model GuestSignup {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId     String
  computerId String

  /// Код вида CF-7K2Q из сообщения гостя.
  code   String            @unique
  status GuestSignupStatus @default(WAITING)

  /// Номер отправителя, известен после подтверждения.
  phone   String?
  /// Аккаунт с этим номером уже есть — гостю задаётся новый PIN, а не новый аккаунт.
  guestId String?

  expiresAt   DateTime
  confirmedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([computerId, createdAt])
}

enum PromoKind {
  /// Деньги на счёт гостя.
  BALANCE
  /// Бонусные баллы.
  BONUS
}

/**
 * Промокод: деньги на счёт или бонусы. Один гость вводит код один раз.
 *
 * clubId пуст — код действует во всех залах сети; иначе только в своём.
 * Хранится в нормализованном виде (заглавные латинские буквы и цифры), поэтому
 * «fox 500», «FOX-500» и «ФОХ500» на русской раскладке — один код.
 */
model PromoCode {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId   String?
  club     Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  code String
  kind PromoKind
  /// В тиын: деньги на счёт или баллы (баллы считаются в тех же единицах, что и бонусы).
  amount Int
  /// Сколько гостей всего могут ввести код. Пусто — без ограничения.
  maxUses   Int?
  usedCount Int  @default(0)
  expiresAt DateTime?
  /// Для себя: где раздавали код, к какой акции он относится.
  comment   String?
  /// Личный код: принимается только у этого гостя. Так выписываются коды
  /// ушедшим гостям — переслать такой код другу бесполезно.
  guestId String?
  guest   Guest?  @relation("PersonalPromo", fields: [guestId], references: [id], onDelete: Cascade)

  createdById String?
  /// Отключённый код больше не принимается; уже начисленное остаётся у гостей.
  disabledAt DateTime?

  redemptions PromoRedemption[]
  winbackMessage WinbackMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([clubId])
  @@index([guestId])
}

/** Кто, где и сколько получил по промокоду. */
model PromoRedemption {
  id       String    @id @default(uuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoId  String
  promo    PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  guestId  String
  guest    Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  /// Зал, где код введён.
  clubId String
  kind   PromoKind
  amount Int

  /// Ввёл администратор на стойке…
  staffId    String?
  /// …или гость сам за игровым ПК.
  computerId String?

  createdAt DateTime @default(now())

  /// Один гость — один раз.
  @@unique([promoId, guestId])
  @@index([guestId])
}

enum BarOrderStatus {
  /// Оплачен с баланса, ждёт администратора.
  NEW
  /// Отнесли гостю.
  DONE
  /// Отменён администратором: деньги вернулись на счёт, товар — на склад.
  CANCELED
}

/**
 * Заказ из бара с игрового ПК. Оплачивается с баланса сразу при заказе:
 * администратор несёт уже оплаченное и не бегает за гостем с терминалом.
 * Позиции — обычные продажи бара (ProductSale), поэтому выручка и маржа
 * считаются тем же отчётом.
 */
model BarOrder {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  guestId  String
  guest    Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  sessionId    String?
  computerId   String
  /// Имя машины на момент заказа — куда нести.
  computerName String

  status BarOrderStatus @default(NEW)
  /// В тиын.
  total  Int
  /// Сколько бонусов начислено за заказ: при отмене они списываются обратно.
  bonusAccrued Int @default(0)
  /// Снимок позиций: [{ productId, name, quantity, price }].
  items Json

  handledById String?
  handledAt   DateTime?

  sales ProductSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, status, createdAt])
}

enum WinbackStatus {
  /// В очереди на отправку.
  PENDING
  SENT
  FAILED
}

/**
 * Рассылка ушедшим гостям: каждому — личный промокод в WhatsApp. По ней видно,
 * сколько гостей ввели код и вернулись и сколько они принесли после возврата.
 */
model WinbackCampaign {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clubId   String
  club     Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdById String?
  kind        PromoKind
  /// В тиын.
  amount      Int
  validDays   Int
  /// Шаблон текста с подстановками {имя}, {клуб}, {подарок}, {код}, {до}.
  message     String

  messages WinbackMessage[]

  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

model WinbackMessage {
  id         String          @id @default(uuid())
  campaignId String
  campaign   WinbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest           @relation(fields: [guestId], references: [id], onDelete: Cascade)
  promoId    String          @unique
  promo      PromoCode       @relation(fields: [promoId], references: [id], onDelete: Cascade)

  status WinbackStatus @default(PENDING)
  providerMessageId String?
  error  String?
  sentAt DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, guestId])
  @@index([status, createdAt])
  @@index([guestId, sentAt])
}
