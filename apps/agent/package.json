{
  "name": "@cyberfox/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Блокировка игровой машины Cyber-Fox",
  "author": "Cyber-Fox",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:renderer dev:electron",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit",
    "pack:win": "pnpm build && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
